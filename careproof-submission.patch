+            "than answer generation. By encoding scope, provenance, dependency, mutation, "
+            "conversation, and terminal-state controls in one reusable protocol, the submission "
+            "targets recurring failure classes while preserving compatibility with the official "
+            "χ-Bench runtime.",
+            body,
+        ),
+        Paragraph("References", heading),
+        Paragraph(
+            "[1] H. Chen et al., “CHI-Bench: Can AI Agents Automate End-to-End, Long-Horizon, "
+            "Policy-Rich Healthcare Workflows?” arXiv:2605.16679, 2026.<br/>"
+            "[2] actAVA AI, “χ-Bench,” official repository and competition documentation, 2026.<br/>"
+            "[3] OpenAI, “OpenAI Agents SDK,” software documentation, 2026.",
+            small,
+        ),
+        Spacer(1, 4),
+    ]
+    doc.build(story)
+
+
+if __name__ == "__main__":
+    build()
